<Window x:Class="Lab3.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление и редактирование товара"
        Height="650"
        Width="550"
        MinHeight="600"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Данные товара"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ID товара:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="IdTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,4"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="1"
                           Text="Наименование:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="NameComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,4"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>

                <TextBlock Grid.Row="2"
                           Text="Категория:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="CategoryComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,4"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>

                <TextBlock Grid.Row="3"
                           Text="Описание:"
                           VerticalAlignment="Top"
                           Margin="0,8"/>

                <TextBox x:Name="DescriptionTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,4"
                         Height="65"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4"
                           Text="Производитель:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="ManufacturerComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Margin="0,4"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>

                <TextBlock Grid.Row="5"
                           Text="Поставщик:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="SupplierComboBox"
                          Grid.Row="5"
                          Grid.Column="1"
                          Margin="0,4"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>

                <TextBlock Grid.Row="6"
                           Text="Цена:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="PriceTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Margin="0,4"/>

                <TextBlock Grid.Row="7"
                           Text="Количество на складе:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="CountTextBox"
                         Grid.Row="7"
                         Grid.Column="1"
                         Margin="0,4"/>

                <TextBlock Grid.Row="8"
                           Text="Действующая скидка (%):"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="DiscountTextBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         Margin="0,4"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="DeleteButton"
                    Content="Удалить"
                    Width="85"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="DeleteButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="85"
                    Height="32"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>