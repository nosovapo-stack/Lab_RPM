<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров"
        Height="650" Width="1000"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список товаров"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Поиск:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox"
                     Height="32"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
        BorderBrush="#333333"
        BorderThickness="2"
        Margin="0,0,0,12"
        Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock FontSize="17"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding CategoryName}"/>
<Run Text=" | "/>
<Run Text="{Binding ProductName}"/>
                                        <Run Text=" | Артикул: "/>
                                        <Run Text="{Binding Article}"/>
                                    </TextBlock>

                                    <TextBlock Margin="0,5,0,0"
                                               TextWrapping="Wrap">
                                        <Run Text="Описание товара: "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>

                                    <TextBlock Margin="0,3,0,0">
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding ManufacturerName}"/>
                                    </TextBlock>

                                    <TextBlock>
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding SupplierName}"/>
                                    </TextBlock>

                                    <TextBlock>
                                        <Run Text="Цена: "/>
                                        <Run Text="{Binding Price}"/>
                                        <Run Text=" руб."/>
                                    </TextBlock>

                                    <TextBlock>
                                        <Run Text="Количество на складе: "/>
                                        <Run Text="{Binding Count}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        Padding="8"
                                        VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Действующая скидка"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>


                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasHighDiscount}"
                 Value="True">
                                <Setter TargetName="CardBorder"
                Property="Background"
                Value="#C8A2C8"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
